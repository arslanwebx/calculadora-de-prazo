RewriteEngine On

# Remove index.html duplicates in one permanent hop.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[\s?]) [NC]
RewriteRule ^(.*/)?index\.html$ https://calculadoradeprazo.pro/$1 [R=301,L,NE]

# Prefer one HTTPS, non-www production origin.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.calculadoradeprazo\.pro$ [NC]
RewriteRule ^ https://calculadoradeprazo.pro%{REQUEST_URI} [R=301,L,NE]

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<Files "sitemap.xml">
  ForceType application/xml
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; connect-src 'self' https://formsubmit.co https://www.google-analytics.com https://region1.google-analytics.com; form-action 'self' https://formsubmit.co; img-src 'self' data: https://www.google-analytics.com; style-src 'self'; script-src 'self' https://www.googletagmanager.com 'sha256-zHKvZxiKb0RN+P0YOfrKHMDHi/g+XpDGFtx9MyLbmHQ='; base-uri 'self'; frame-ancestors 'none'"
  <Files "404.html">
    Header always set X-Robots-Tag "noindex, follow"
  </Files>
</IfModule>
